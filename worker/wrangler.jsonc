{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "focado-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "FOCADO_ALLOWED_ORIGIN": "https://thiagovpinho-cloud.github.io"
  }
}
